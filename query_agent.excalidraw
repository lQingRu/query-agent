    {
      "id": "A8f4IXSCJIKnQXhYwmlPq",
      "type": "text",
      "x": 1419.2323751298209,
      "y": 1734.6088641938709,
      "width": 412.95965576171875,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
