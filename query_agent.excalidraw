      "boundElements": [],
      "updated": 1740997275965,
      "link": null,
      "locked": false,
      "text": "Multi-Agent's Goals:\n\n✅ Understand user intent (detect vague or ambiguous queries).\n✅ Expand or rewrite queries for better semantic search.\n✅ Decompose complex queries into sub-queries if needed.\n✅ Evaluate multiple refined queries to select the best one.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "0kIitIRvFIi6M-NiGeOuG",
      "originalText": "Multi-Agent's Goals:\n\n✅ Understand user intent (detect vague or ambiguous queries).\n✅ Expand or rewrite queries for better semantic search.\n✅ Decompose complex queries into sub-queries if needed.\n✅ Evaluate multiple refined queries to select the best one.",
      "autoResize": true,
      "lineHeight": 1.25
    },
